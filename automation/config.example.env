# deployment env var; it is listed here only for operator reference.
REQUEST_GENERATION_EXECUTOR_URL=
ROUTERAI_API_KEY=
ROUTERAI_MODEL=anthropic/claude-sonnet-5
ROUTERAI_IMAGE_MODEL=black-forest-labs/flux.2-pro
REQUEST_DEMO_BUCKET=
REQUEST_DEMO_ORIGIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
