---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/request-thread.css";

const title = "Страница заявки — Lazysoft";
const description = "Приватная страница заявки: статус, сообщения, демонстрация интерфейса.";
---

<SiteLayout title={title} description={description} canonicalPath="/request/" noindex mainClass="request-page">
  <section class="request-shell" aria-labelledby="request-title">
    <header class="request-intro">
      <p class="request-kicker">Приватная страница заявки</p>
      <h1 id="request-title">Результат и сообщения<br /><em>в одном месте.</em></h1>
      <p>Сохраните эту страницу. Здесь появятся демо интерфейса и вопросы по вашей идее.</p>
      <div class="request-actions">
        <button type="button" class="request-secondary-button" data-copy-request-link>Скопировать секретную ссылку</button>
        <a href="https://t.me/SeeeRGo88" target="_blank" rel="noopener noreferrer">Написать напрямую ↗</a>
      </div>
    </header>

    <div class="request-panel" data-request-panel aria-live="polite">
      <div class="request-loading" data-request-loading>
        <span></span>
        <p>Загружаю заявку…</p>
      </div>

      <div data-request-content hidden>
        <div class="request-panel-head">
          <div>
            <span data-request-id>Заявка</span>
            <h2 data-request-status-label>Получена</h2>
          </div>
          <span class="request-status-badge" data-request-status>Получена</span>
        </div>

        <details class="request-idea">
          <summary>Описание идеи</summary>
          <p data-request-idea></p>
        </details>

        <div class="request-messages" data-request-messages aria-label="Сообщения по заявке"></div>

        <section class="request-next-steps" data-automation hidden aria-label="Что дальше">
          <h2>Что дальше</h2>
          <p data-automation-status></p>
          <div data-messenger-connect hidden>
            <p>Чтобы получить уведомление о результате, откройте бота и нажмите «Начать».</p>
            <div class="request-actions">
              <a data-connect-telegram hidden target="_blank" rel="noopener noreferrer">Получить результат в Telegram ↗</a>
              <a data-connect-max hidden target="_blank" rel="noopener noreferrer">Получить результат в MAX ↗</a>
            </div>
          </div>
          <div data-automation-review hidden>
            <p>Посмотрите демо. Можно один раз отправить общий список правок или принять результат сразу.</p>
            <form data-revision-form>
              <label for="revision-text">Что изменить в демо?</label>
              <textarea id="revision-text" name="revision" minlength="10" maxlength="3000" rows="3" required placeholder="Соберите все пожелания в одно сообщение"></textarea>
              <button type="submit">Отправить правки · 1 раз бесплатно</button>
            </form>
            <button type="button" data-accept-result>Всё подходит — принять результат</button>
          </div>
          <div data-automation-purchase hidden>
            <h3>Забрать исходники — 5 000 ₽</h3>
            <p>Архив демоверсии с инструкцией запуска. Дальнейшая разработка и внешние сервисы оплачиваются отдельно.</p>
            <p>Нажмите кнопку — я получу уведомление. Оплату и передачу исходников обсудим здесь, в чате заявки.</p>
            <button type="button" data-request-source>Хочу купить исходники за 5 000 ₽</button>
            <p data-source-requested hidden role="status">Запрос отправлен. Напишу вам в этом чате, чтобы согласовать оплату и передачу исходников.</p>
          </div>
          <button type="button" data-download-source hidden>Скачать оплаченные исходники</button>
          <div data-development-choice hidden>
            <h3>Довести до рабочего продукта</h3>
            <p>Доработка от 10 000 ₽ с постоплатой. Сначала согласуем объём, стоимость и критерии готовности.</p>
            <button type="button" data-request-development>Обсудить доработку</button>
          </div>
          <p class="request-form-status" data-automation-feedback hidden role="status"></p>
        </section>

        <form class="request-composer" data-request-message-form>
          <label for="request-message">Ответить или дополнить заявку</label>
          <textarea id="request-message" name="message" rows="3" maxlength="2000" required placeholder="Напишите уточнение или ответ…"></textarea>
          <div>
            <p>Сообщение увидит разработчик на этой странице заявки.</p>
            <button type="submit">Отправить →</button>
          </div>
          <p class="request-form-status" data-request-form-status hidden></p>
        </form>
      </div>

      <div class="request-error" data-request-error hidden>
        <span>Ссылка не открылась</span>
        <h2>Не удалось найти заявку</h2>
        <p data-request-error-text>Проверьте, что секретная ссылка скопирована полностью.</p>
        <a href="/mvp-za-3-dnya/">Вернуться к форме →</a>
      </div>
    </div>
  </section>

  <section class="request-security-note section">
    <p><strong>Важно:</strong> любой человек с этой ссылкой сможет прочитать переписку и отправить сообщение. Не публикуйте её и не добавляйте пароли, платёжные данные или сведения третьих лиц.</p>
  </section>

  <script src="../scripts/request-thread.ts"></script>
  <script src="../scripts/request-automation.ts"></script>
</SiteLayout>
