---
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/mvp.css";

const title = "Оценка идеи приложения за 6 часов — варианты разработки | Lazysoft";
const description =
  "Опишите идею приложения текстом или голосом. В течение 6 часов получите ТЗ в PDF с вариантами реализации и демо ключевого интерфейса — от 3 дней и 10 000 рублей.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Предварительная оценка идеи приложения",
    description,
    url: "https://lazysoft.ru/mvp-za-3-dnya/",
    provider: { "@type": "Organization", name: "Lazysoft", url: "https://lazysoft.ru" },
    areaServed: "RU",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Что я получу?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "ТЗ в PDF с несколькими вариантами реализации идеи, ориентировочными сроками, стоимостью и рисками, а также ссылку на демонстрационный макет ключевого интерфейса.",
        },
      },
      {
        "@type": "Question",
        name: "Обязательно ли после этого заказывать разработку?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Нет. Предварительный PDF бесплатный и ни к чему не обязывает.",
        },
      },
      {
        "@type": "Question",
        name: "Любую ли идею можно реализовать за 3 дня и 10 000 рублей?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Нет. Это нижняя граница для небольшого согласованного сценария. В PDF будут предложены реалистичные варианты под конкретную задачу.",
        },
      },
    ],
  },
];
---

<SiteLayout title={title} description={description} canonicalPath="/mvp-za-3-dnya/" structuredData={structuredData} mainClass="mvp-page">
  <section class="mvp-lead-hero" aria-labelledby="mvp-lead-title">
    <div class="mvp-lead-copy">
      <Breadcrumbs items={[{ label: "Услуги", href: "/services/" }, { label: "Разбор идеи" }]} />
      <p class="mvp-lead-badge"><span></span> Бесплатный предварительный разбор</p>
      <h1 id="mvp-lead-title">Опишите идею.<br /><em>За 6 часов</em> получите варианты реализации.</h1>
      <p class="mvp-lead-lede">
        Я изучу задачу и пришлю ТЗ в PDF с несколькими реалистичными вариантами и демо ключевого интерфейса:
        от небольшой первой версии <strong>от 3 рабочих дней и 10 000 ₽</strong> до более полного решения.
      </p>

      <ul class="mvp-lead-value" aria-label="Что будет в результате">
        <li><span>01</span><div><b>ТЗ с вариантами</b><small>разный объём и подход</small></div></li>
        <li><span>02</span><div><b>Срок и стоимость</b><small>для каждого варианта</small></div></li>
        <li><span>03</span><div><b>Демо интерфейса</b><small>макет ключевых экранов</small></div></li>
      </ul>

      <p class="mvp-lead-fineprint">Бесплатно и без обязательства заказывать разработку. Окончательный объём согласуем отдельно до начала работ.</p>
    </div>

    <aside class="mvp-request-card">
      <div class="mvp-request-heading">
        <p>Заявка на разбор</p>
        <h2>Достаточно 2–3 предложений</h2>
        <span>Можно написать или наговорить — технические термины не нужны.</span>
      </div>

      <form data-mvp-request-form novalidate>
        <label class="mvp-request-field mvp-request-idea">
          <span>Что хотите сделать? <b>*</b></span>
          <textarea name="idea" rows="4" minlength="20" maxlength="3000" required placeholder="Например: хочу сервис, который собирает заявки из почты и создаёт задачи менеджерам..."></textarea>
          <button type="button" class="mvp-voice-button" data-voice-button aria-label="Наговорить описание идеи">● Наговорить</button>
        </label>

        <fieldset class="mvp-contact-choice">
          <legend>Куда прислать ТЗ и демо? <b>*</b></legend>
          <div>
            <label><input type="radio" name="contactMethod" value="telegram" checked /><span>Telegram</span></label>
            <label><input type="radio" name="contactMethod" value="email" /><span>Почта</span></label>
            <label><input type="radio" name="contactMethod" value="max" /><span>MAX</span></label>
          </div>
        </fieldset>

        <label class="mvp-request-field mvp-contact-field">
          <span data-contact-label>Ваш Telegram <b>*</b></span>
          <input type="text" name="contact" required minlength="3" maxlength="200" autocomplete="off" placeholder="@username" data-contact-input />
          <small data-contact-hint>Укажите @username или ссылку на профиль.</small>
        </label>

        <label class="mvp-honeypot" aria-hidden="true">
          <span>Сайт</span><input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <button class="mvp-request-submit" type="submit">
          <span>Получить ТЗ и демо →</span>
          <small>Результат придёт в течение 6 часов</small>
        </button>

        <p class="mvp-request-privacy">Описание и контакт сохраняются для подготовки и отправки ответа. Не добавляйте пароли и данные третьих лиц.</p>
        <p class="mvp-request-status" data-request-status hidden aria-live="polite"></p>
      </form>

      <div class="mvp-request-success" data-request-success hidden tabindex="-1">
        <span>Заявка отправлена ✓</span>
        <h2>Вернусь с вариантами в течение 6 часов</h2>
        <p>Подготовлю ТЗ в PDF и демо ключевого интерфейса, затем пришлю их по указанному контакту. Если для оценки не хватит одной детали, сначала задам короткий вопрос.</p>
      </div>

      <div class="mvp-direct-contact" aria-label="Прямые контакты">
        <p>Если вам не ответили в течение 6 часов, напишите напрямую.</p>
        <a class="mvp-direct-button" href="https://t.me/SeeeRGo88" target="_blank" rel="noopener noreferrer" data-direct-contact="telegram">Написать напрямую →</a>
        <div>
          <a href="mailto:hello@lazysoft.ru?subject=Идея для Lazysoft" data-direct-contact="email">hello@lazysoft.ru</a>
          <a href="https://t.me/SeeeRGo88" target="_blank" rel="noopener noreferrer" data-direct-contact="telegram">Telegram: @SeeeRGo88</a>
          <a href="https://max.ru/" target="_blank" rel="noopener noreferrer" title="Откройте MAX и найдите контакт по номеру" data-direct-contact="max">MAX: +7 929 712-49-04</a>
        </div>
      </div>
    </aside>
  </section>

  <section class="mvp-explanation section" id="variants" aria-labelledby="mvp-explanation-title">
    <div class="section-head">
      <p class="kicker">Что вы получите</p>
      <h2 id="mvp-explanation-title">Не одна абстрактная оценка, а выбор</h2>
    </div>
    <div class="mvp-variants">
      <article><span>Минимальный</span><h3>Проверить главное</h3><p>Самый небольшой полезный сценарий. Если задача подходит — от 3 рабочих дней и 10 000 ₽.</p></article>
      <article><span>Практичный</span><h3>Решить рабочую задачу</h3><p>Больше автоматизации, нужные данные и интеграции без преждевременного усложнения.</p></article>
      <article><span>Расширенный</span><h3>Развивать дальше</h3><p>Этапы развития, дополнительные сценарии и технические риски с отдельной оценкой.</p></article>
    </div>
    <p class="mvp-boundary-note"><strong>Важно:</strong> 3 дня и 10 000 ₽ — стартовая граница для небольшого согласованного сценария, а не обещание реализовать любую идею за эту сумму.</p>
  </section>

  <section class="mvp-simple-faq section" id="faq" aria-labelledby="mvp-faq-title">
    <div class="section-head"><p class="kicker">Коротко об условиях</p><h2 id="mvp-faq-title">До отправки идеи</h2></div>
    <div class="faq-list">
      <details><summary>Что именно я получу?</summary><p>ТЗ в PDF: варианты объёма, пользовательские сценарии, ориентировочные сроки и стоимость, возможные внешние расходы, риски и открытые вопросы. Вместе с ним — ссылка на демонстрационный макет ключевого интерфейса.</p></details>
      <details><summary>Нужно ли потом что-то заказывать?</summary><p>Нет. Предварительный разбор бесплатный и ни к чему не обязывает.</p></details>
      <details><summary>Когда начинается разработка?</summary><p>Только после отдельного согласования итогового состава работ, критериев готовности, срока, цены и внешних расходов обеими сторонами.</p></details>
    </div>
  </section>

  <script src="../scripts/mvp-brief.ts"></script>
</SiteLayout>
