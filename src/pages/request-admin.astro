---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/request-thread.css";

const title = "Управление заявкой — Lazysoft";
const description = "Закрытая страница ответа на заявку Lazysoft.";
---

<SiteLayout title={title} description={description} canonicalPath="/request-admin/" noindex mainClass="request-page request-admin-page">
  <section class="request-shell request-admin-shell" aria-labelledby="admin-request-title">
    <header class="request-intro">
      <p class="request-kicker">Управление заявкой</p>
      <h1 id="admin-request-title"><span>Один сайт.</span><em>Диалог по делу.</em></h1>
      <p>Закрытое рабочее окно одной заявки: идея клиента, опубликованные демо и переписка.</p>
      <div class="request-admin-guide">
        <h2>Как устроена генерация</h2>
        <p>Сначала создаётся первый сайт. Затем клиент может запросить ещё две последовательные доработки — по одной, после просмотра результата.</p>
        <p>Исходники оплачиваются отдельно. Сообщения администратора и смена статуса не запускают ИИ и не расходуют доработки.</p>
      </div>
    </header>

    <div class="request-panel" data-admin-panel>
      <div class="request-loading" data-admin-loading role="status"><span aria-hidden="true"></span><p>Загружаю заявку…</p></div>

      <div data-admin-content hidden>
        <div class="request-panel-head">
          <div><span data-admin-request-id>Заявка</span><h2 data-admin-status-label>Получена</h2></div>
          <span class="request-status-badge" data-admin-status>Получена</span>
        </div>

        <div class="request-admin-sync">
          <p data-admin-sync role="status" aria-live="polite" aria-atomic="true">Проверяю обновления…</p>
          <button type="button" class="request-secondary-button" data-admin-refresh>Обновить</button>
        </div>

        <div class="request-admin-meta">
          <div><span>Контакт</span><strong data-admin-contact></strong></div>
          <div><span>Канал</span><strong data-admin-contact-method></strong></div>
          <div class="request-admin-idea"><span>Идея</span><p data-admin-idea></p></div>
        </div>

        <section class="request-admin-notification" data-admin-notification hidden aria-labelledby="admin-notification-title">
          <div>
            <span id="admin-notification-title">Уведомление клиента</span>
            <strong data-admin-notification-status>Ждёт сообщения</strong>
            <p data-admin-notification-note>Напишите клиенту по указанному контакту и отметьте отправку.</p>
          </div>
          <button type="button" class="request-secondary-button" data-admin-mark-notified>Пользователь уведомлён</button>
        </section>

        <section class="request-admin-demos" aria-labelledby="admin-demos-title">
          <div><h2 id="admin-demos-title">Опубликованные демо</h2><span data-admin-demo-count></span></div>
          <p data-admin-demo-empty>В переписке пока нет ссылок на демо.</p>
          <ul data-admin-demos hidden></ul>
          <p class="request-admin-demo-note">Только ссылки из сообщений. Они не показывают этап генерации или число оставшихся доработок.</p>
        </section>

        <h2 class="request-admin-section-title" id="admin-messages-title">Переписка</h2>
        <div class="request-messages" data-admin-messages role="region" tabindex="0" aria-labelledby="admin-messages-title"></div>

        <form class="request-composer request-admin-composer" data-admin-message-form aria-describedby="admin-composer-note">
          <label for="admin-message">Сообщение клиенту</label>
          <textarea id="admin-message" name="message" rows="4" maxlength="5000" aria-describedby="admin-form-status" placeholder="Например: первый сайт готов. Посмотрите демо и напишите, что хотите изменить."></textarea>
          <div class="request-result-fields">
            <label for="admin-demo">Ссылка на демо<input id="admin-demo" type="url" name="demoUrl" maxlength="1200" placeholder="https://…" aria-describedby="admin-form-status" /></label>
            <label for="admin-status">Статус после отправки
              <select id="admin-status" name="status">
                <option value="in_progress">В работе</option>
                <option value="ready">Результат готов</option>
                <option value="failed">Нужна ручная проверка</option>
                <option value="closed">Закрыта</option>
                <option value="received">Получена</option>
              </select>
            </label>
          </div>
          <div>
            <p id="admin-composer-note">Ответ появится на странице заявки. Это ручное сообщение, не команда для ИИ.</p>
            <button type="submit">Опубликовать ответ →</button>
          </div>
          <p class="request-form-status" id="admin-form-status" data-admin-form-status role="status" aria-live="polite" aria-atomic="true" hidden></p>
        </form>
      </div>

      <div class="request-error" data-admin-error hidden>
        <div role="alert"><span>Заявка недоступна</span><h2>Не удалось открыть заявку</h2>
        <p data-admin-error-text>Откройте ссылку из уведомления Telegram целиком.</p></div>
        <button type="button" class="request-secondary-button" data-admin-retry hidden>Попробовать снова</button>
      </div>
    </div>
  </section>

  <script src="../scripts/request-admin.ts"></script>
</SiteLayout>
