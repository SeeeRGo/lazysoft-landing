---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/mvp.css";
import "../styles/waiting.css";
import "../styles/site-generator.css";
const title = "Генератор сайтов по идее с ИИ | Lazysoft";
const description = "Опишите идею — ИИ через OpenRouter создаст первую версию сайта. Демо публикуется в Яндекс Облаке. Без регистрации, контакт для уведомления — по желанию.";
---
<BaseLayout title={title} description={description} canonicalPath="/sayt-po-idee/">
  <header class="generator-header">
    <a class="brand" href="/" aria-label="Lazysoft — на главную"><img src="/lazysoft-logo.webp" alt="" width="38" height="38" /><span class="brand-name">lazy<em>soft</em></span></a>
  </header>
  <main class="generator-page">
    <section class="generator-card" aria-labelledby="generator-title">
      <p class="generator-eyebrow">Идея → ИИ → ваш сайт</p>
      <h1 id="generator-title">Ваш сайт начинается<br />с одной идеи.</h1>
      <p class="generator-intro">Расскажите, что вы задумали. ИИ создаст первую версию,<br class="generator-desktop-break" /> а мы опубликуем демо в Яндекс Облаке.</p>
      <form id="site-idea-form" data-mvp-request-form novalidate>
        <label class="mvp-request-field mvp-request-idea">
          <span class="visually-hidden">Идея сайта</span>
          <textarea name="idea" rows="4" minlength="10" maxlength="3000" required aria-describedby="idea-hint" placeholder="Например, сайт небольшой керамической мастерской: каталог посуды, история мастера и запись на занятия. Тёплые оттенки, крупные фото, много воздуха."></textarea>
        </label>
        <label class="mvp-honeypot" aria-hidden="true"><span>Сайт</span><input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <p class="generator-hint" id="idea-hint">Для кого сайт, что на нём должно быть и какое настроение передать?</p>
        <label class="generator-notify-toggle">
          <input type="checkbox" data-notify-toggle />
          <span><strong>Оставьте контакт — я лично напишу, когда версия будет готова</strong><small>Необязательно. Статус и результат в любом случае останутся на странице заявки.</small></span>
        </label>
        <div class="generator-contact" data-notify-fields hidden>
          <fieldset class="mvp-contact-choice">
            <legend>Куда вам написать?</legend>
            <div>
              <label><input type="radio" name="contactMethod" value="email" checked /><span>Почта</span></label>
              <label><input type="radio" name="contactMethod" value="telegram" /><span>Telegram</span></label>
              <label><input type="radio" name="contactMethod" value="max" /><span>MAX</span></label>
            </div>
          </fieldset>
          <label class="mvp-request-field mvp-contact-field">
            <span data-contact-label>Ваша почта <b>*</b></span>
            <input type="email" name="contact" minlength="3" maxlength="200" autocomplete="email" placeholder="name@example.ru" data-contact-input />
            <small data-contact-hint>Напишу на этот адрес, когда версия будет готова.</small>
          </label>
          <p class="generator-contact-note">Для Telegram и MAX оставьте username, телефон или ссылку на профиль — я напишу вручную после проверки результата.</p>
        </div>
        <button class="mvp-request-submit" type="submit"><span>Сгенерировать сайт →</span></button>
        <p class="generator-note">Первое демо бесплатно · без регистрации · обычно до 15 минут</p>
        <p class="mvp-request-status" data-request-status hidden aria-live="polite"></p>
      </form>
      <ol class="generator-steps" aria-label="Как это работает">
        <li><span>01</span><div><strong>Опишите идею</strong><p>Достаточно пары предложений.</p></div></li>
        <li><span>02</span><div><strong>ИИ соберёт сайт</strong><p>Генерация через OpenRouter.</p></div></li>
        <li><span>03</span><div><strong>Откройте демо</strong><p>Ссылка в Яндекс Облаке и две доработки.</p></div></li>
      </ol>
      <p class="generator-disclaimer">Демо — прототип, не готовый бизнес-сервис. Исходники с админкой и помощь с установкой оплачиваются отдельно.</p>
    </section>
  </main>
  <script src="../scripts/mvp-brief.ts"></script>
</BaseLayout>
