---
import SiteLayout from "../layouts/SiteLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import "../styles/mvp.css";
import "../styles/crm-automation.css";

const title = "Доработка CRM и автоматизация процессов | Lazysoft";
const description =
  "Доработка Битрикс24 и других CRM под процессы бизнеса: приложения, модули, отчёты, интеграции и автоматизация. Если коробки недостаточно — разработка собственной небольшой CRM.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Доработка CRM и автоматизация бизнес-процессов",
    description,
    url: "https://lazysoft.ru/crm-automation/",
    provider: { "@type": "Organization", name: "Lazysoft", url: "https://lazysoft.ru" },
    areaServed: "RU",
    offers: { "@type": "Offer", priceCurrency: "RUB", price: "10000", description: "Небольшая первая версия от 3 рабочих дней" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Обязательно ли разрабатывать CRM с нуля?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Нет. Часто правильнее доработать существующую CRM: добавить приложение, отчёт, интеграцию или недостающий рабочий экран. Собственная CRM нужна только когда коробочное решение ограничивает ключевой процесс.",
        },
      },
      {
        "@type": "Question",
        name: "Можно ли разработать аналог функции приложения из CRM-маркета?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Можно независимо реализовать нужный бизнес-сценарий без копирования чужого кода и интерфейса. Сначала стоит проверить, нельзя ли дешевле расширить или интегрировать уже найденное приложение.",
        },
      },
      {
        "@type": "Question",
        name: "Нужно ли сразу заказывать разработку?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Нет. Предварительная схема автоматизации, варианты реализации и демо интерфейса бесплатны и ни к чему не обязывают.",
        },
      },
    ],
  },
];
---

<SiteLayout title={title} description={description} canonicalPath="/crm-automation/" structuredData={structuredData} mainClass="mvp-page crm-page">
  <section class="mvp-lead-hero crm-hero" aria-labelledby="crm-title">
    <div class="mvp-lead-copy">
      <Breadcrumbs items={[{ label: "Услуги", href: "/services/" }, { label: "CRM и автоматизация" }]} />
      <p class="mvp-lead-badge"><span></span> Доработка CRM и автоматизация</p>
      <h1 id="crm-title">CRM работает <span class="crm-no-break">по-вашему.</span><br /><em>Не наоборот.</em></h1>
      <p class="mvp-lead-lede">
        Доработаю существующую CRM под ваш процесс: добавлю приложение, отчёт, рабочий экран или интеграцию.
        Если коробочного решения недостаточно — <strong>соберу небольшую собственную CRM без лишних разделов.</strong>
      </p>

      <ul class="mvp-lead-value" aria-label="Что изменится после автоматизации">
        <li><span>01</span><div><b>Без лишнего переезда</b><small>сохраняем знакомую CRM и данные</small></div></li>
        <li><span>02</span><div><b>Недостающая функция</b><small>модуль, отчёт, фильтр или интеграция</small></div></li>
        <li><span>03</span><div><b>Своя CRM — если нужно</b><small>только когда доработка не решает задачу</small></div></li>
      </ul>

      <p class="mvp-lead-fineprint">
        За 6 часов пришлю схему автоматизации, демо ключевого интерфейса и варианты реализации.
        Небольшая первая версия — <strong>от 3 рабочих дней и 10 000 ₽.</strong>
      </p>
    </div>

    <aside class="mvp-request-card crm-request-card">
      <div class="mvp-request-heading">
        <p>Бесплатный предварительный разбор</p>
        <h2>Чего не хватает вашей CRM?</h2>
        <span>Назовите систему и опишите недостающую функцию обычными словами или голосом.</span>
      </div>

      <form data-crm-request-form data-default-campaign="crm_automation" novalidate>
        <label class="mvp-request-field mvp-request-idea">
          <span>Что используется сейчас и что нужно изменить? <b>*</b></span>
          <textarea name="idea" rows="4" minlength="20" maxlength="3000" required placeholder="Например: работаем в коробочном Битрикс24. Нужен экран контроля дней без звонков и сообщений с фильтрами по сотруднику и виду коммуникации..."></textarea>
          <button type="button" class="mvp-voice-button" data-voice-button aria-label="Наговорить описание доработки">● Наговорить</button>
        </label>

        <fieldset class="mvp-contact-choice">
          <legend>Куда прислать схему и демо? <b>*</b></legend>
          <div>
            <label><input type="radio" name="contactMethod" value="telegram" checked /><span>Telegram</span></label>
            <label><input type="radio" name="contactMethod" value="email" /><span>Почта</span></label>
            <label><input type="radio" name="contactMethod" value="max" /><span>MAX</span></label>
          </div>
        </fieldset>

        <label class="mvp-request-field mvp-contact-field">
          <span data-contact-label>Ваш Telegram <b>*</b></span>
          <input type="text" name="contact" required minlength="3" maxlength="200" autocomplete="off" placeholder="@username" data-contact-input />
          <small data-contact-hint>Укажите @username или ссылку на профиль.</small>
        </label>

        <label class="mvp-honeypot" aria-hidden="true">
          <span>Сайт</span><input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <button class="mvp-request-submit" type="submit">
          <span>Получить схему автоматизации →</span>
          <small>Разбор и демо в течение 6 часов</small>
        </button>

        <p class="mvp-request-privacy">Описание и контакт нужны только для подготовки ответа. Не добавляйте пароли, клиентские базы и данные третьих лиц.</p>
        <p class="mvp-request-status" data-request-status hidden aria-live="polite"></p>
      </form>

      <div class="mvp-request-success" data-request-success hidden tabindex="-1">
        <span>Процесс отправлен ✓</span>
        <h2>Вернусь со схемой в течение 6 часов</h2>
        <p>Покажу, можно ли доработать текущую CRM, как будет выглядеть интерфейс и сколько займут разные варианты.</p>
      </div>

      <div class="mvp-direct-contact" aria-label="Прямые контакты">
        <p>Если не ответил в течение 6 часов, напишите напрямую.</p>
        <a class="mvp-direct-button" href="https://t.me/SeeeRGo88" target="_blank" rel="noopener noreferrer" data-direct-contact="telegram">Написать напрямую →</a>
        <div>
          <a href="mailto:hello@lazysoft.ru?subject=Автоматизация заявок" data-direct-contact="email">hello@lazysoft.ru</a>
          <a href="https://t.me/SeeeRGo88" target="_blank" rel="noopener noreferrer" data-direct-contact="telegram">Telegram: @SeeeRGo88</a>
          <a href="https://max.ru/" target="_blank" rel="noopener noreferrer" title="Откройте MAX и найдите контакт по номеру" data-direct-contact="max">MAX: +7 929 712-49-04</a>
        </div>
      </div>
    </aside>
  </section>

  <section class="section crm-capabilities" id="capabilities" aria-labelledby="crm-capabilities-title">
    <div class="section-head">
      <p class="kicker">Что можно автоматизировать</p>
      <h2 id="crm-capabilities-title">Добавить недостающее — не заменяя полезное</h2>
      <p class="lede">Сначала проверяем, можно ли решить задачу доработкой текущей системы. Разработка с нуля — не отправная точка, а один из вариантов.</p>
    </div>
    <div class="crm-capability-grid">
      <article><span>01</span><h3>Доработка CRM</h3><p>Новые поля, сценарии, права, фильтры и рабочие экраны внутри используемой системы.</p></article>
      <article><span>02</span><h3>Приложение или модуль</h3><p>Отдельная функция для Битрикс24 или другой CRM, когда стандартных возможностей недостаточно.</p></article>
      <article><span>03</span><h3>Отчёты и контроль</h3><p>Показатели, просрочки и проблемные ситуации видны руководителю без ручной сводки.</p></article>
      <article><span>04</span><h3>Интеграции</h3><p>Сайт, почта, телефония, мессенджеры и внешние сервисы обмениваются нужными данными.</p></article>
      <article><span>05</span><h3>Автоматические действия</h3><p>Задачи, уведомления, документы и смена статусов запускаются по правилам процесса.</p></article>
      <article><span>06</span><h3>Собственная мини-CRM</h3><p>Небольшой отдельный инструмент, если расширять коробочную систему дороже или неудобнее.</p></article>
    </div>
  </section>

  <section class="section crm-case" id="example" aria-labelledby="crm-case-title">
    <div class="crm-case-copy">
      <p class="kicker">Пример подходящей задачи</p>
      <h2 id="crm-case-title">Контроль коммуникаций в коробочном Битрикс24</h2>
      <p>Компания уже работает в CRM, а приложение из маркета подходит только на 90%. Вместо замены всей системы можно оценить отдельный модуль:</p>
      <ul>
        <li>лиды и сделки — по строкам, дни — по столбцам;</li>
        <li>в ячейке — количество звонков или сообщений за день;</li>
        <li>пропущенные звонки и долгое отсутствие связи выделяются;</li>
        <li>есть фильтры по сотруднику, виду коммуникации и периоду;</li>
        <li>ограничивается объём загружаемых данных.</li>
      </ul>
      <p class="crm-case-note">На разборе сначала сравню три пути: расширить найденное приложение, сделать отдельное приложение для текущей CRM или вынести функцию в связанный веб-инструмент.</p>
    </div>
    <div class="crm-case-demo" aria-label="Условный пример экрана контроля коммуникаций">
      <div class="crm-case-toolbar"><span>Сотрудник: Анна</span><span>Звонки</span><span>7 дней</span></div>
      <div class="crm-case-table" role="table">
        <div class="crm-case-row crm-case-head" role="row"><b role="columnheader">Клиент</b><b role="columnheader">Пн</b><b role="columnheader">Вт</b><b role="columnheader">Ср</b><b role="columnheader">Чт</b></div>
        <div class="crm-case-row" role="row"><span role="cell">Альфа</span><i role="cell">2</i><i role="cell">1</i><i role="cell">3</i><i role="cell">1</i></div>
        <div class="crm-case-row" role="row"><span role="cell">Вектор</span><i role="cell">1</i><i role="cell" class="is-missed">0</i><i role="cell">2</i><i role="cell">1</i></div>
        <div class="crm-case-row" role="row"><span role="cell">Маяк</span><i role="cell">3</i><i role="cell">2</i><i role="cell">1</i><i role="cell" class="is-warning">4</i></div>
      </div>
      <p><span class="crm-case-dot is-missed"></span> пропущенный звонок <span class="crm-case-dot is-warning"></span> давно не связывались</p>
    </div>
  </section>

  <section class="section crm-result" id="result" aria-labelledby="crm-result-title">
    <div class="section-head">
      <p class="kicker">Результат бесплатного разбора</p>
      <h2 id="crm-result-title">Сначала варианты доработки. Потом решение о разработке</h2>
    </div>
    <div class="mvp-variants crm-result-grid">
      <article><span>Система</span><h3>Что можно сохранить</h3><p>Проверю ограничения текущей CRM и покажу, можно ли добавить функцию без переноса процессов и данных.</p></article>
      <article><span>Интерфейс</span><h3>Как будет выглядеть доработка</h3><p>Подготовлю демонстрацию ключевого экрана под ваш сценарий, а не абстрактный шаблон.</p></article>
      <article><span>Варианты</span><h3>Модуль, интеграция или своя CRM</h3><p>Сравню реалистичные подходы по объёму, сроку, стоимости, ограничениям и внешним расходам.</p></article>
    </div>
    <p class="mvp-boundary-note"><strong>Без обязательств:</strong> разработка начинается только после отдельного согласования функций, срока, стоимости и внешних расходов.</p>
  </section>

  <section class="section crm-process" id="process" aria-labelledby="crm-process-title">
    <div class="section-head"><p class="kicker">Как проходит работа</p><h2 id="crm-process-title">Сначала изучаем текущую систему</h2></div>
    <ol class="crm-process-list">
      <li><span>1</span><div><h3>Вы описываете систему</h3><p>Какая CRM и редакция используется, какой функции не хватает и что уже пробовали.</p></div></li>
      <li><span>2</span><div><h3>Я сравниваю варианты</h3><p>Проверяю доработку, отдельный модуль, интеграцию и собственный инструмент — только подходящие пути.</p></div></li>
      <li><span>3</span><div><h3>Согласуем первую версию</h3><p>Фиксируем наиболее ценный сценарий и критерии готовности. До согласия обеих сторон работа не начинается.</p></div></li>
      <li><span>4</span><div><h3>Запускаем и проверяем</h3><p>Вы получаете работающий веб-инструмент, исходный код и инструкцию запуска.</p></div></li>
    </ol>
  </section>

  <section class="mvp-simple-faq section" id="faq" aria-labelledby="crm-faq-title">
    <div class="section-head"><p class="kicker">До отправки процесса</p><h2 id="crm-faq-title">Короткие ответы</h2></div>
    <div class="faq-list">
      <details><summary>Обязательно ли разрабатывать CRM с нуля?</summary><p>Нет. Если бизнес уже работает в Битрикс24 или другой системе, сначала рассматриваем доработку: приложение, модуль, отчёт, интеграцию или связанный веб-инструмент.</p></details>
      <details><summary>Можно повторить недостающую функцию приложения из маркета?</summary><p>Можно независимо реализовать тот же бизнес-сценарий без копирования чужого кода и фирменного интерфейса. Но сначала стоит проверить, нельзя ли дешевле расширить или интегрировать уже найденное приложение.</p></details>
      <details><summary>Что реально сделать от 3 дней и 10 000 ₽?</summary><p>Небольшой законченный сценарий: например, единая очередь заявок, карточка клиента, статусы и назначение ответственного. Интеграции, сложные права доступа и аналитика оцениваются отдельно.</p></details>
      <details><summary>Можно подключить Telegram, почту, сайт или 1С?</summary><p>Да, если сервис предоставляет подходящий API или другой надёжный способ интеграции. Возможности, стоимость внешних сервисов и ограничения перечислю до начала разработки.</p></details>
      <details><summary>Нужно ли после разбора заказывать разработку?</summary><p>Нет. Схема, предварительные варианты и демо бесплатны и ни к чему не обязывают.</p></details>
    </div>
  </section>

  <script src="../scripts/mvp-brief.ts"></script>
</SiteLayout>
