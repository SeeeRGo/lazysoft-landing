  },
  {
    href: "https://habr.com/ru/articles/703086/",
    date: "Дек 2022 - 8 мин - 1.9K прочтений",
    title: "Поиски баланса в составлении функциональных требований",
    description: "Продолжение серии про Shape Up с фокусом на shaping требований до начала реализации.",
  },
  {
    href: "https://habr.com/ru/articles/692040/",
    date: "Окт 2022 - 7 мин - 12.3K прочтений",
    title: "Мейнстримовый Agile пора выбрасывать на свалку истории!?",
    description: "Первая статья про Shape Up: взгляд разработчика на процессы за пределами привычных Agile-ритуалов.",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="grain" aria-hidden="true"></div>
  <div class="sun" aria-hidden="true"><span class="sun-core"></span></div>

  <header class="nav" id="top">
    <a class="brand" href="#top">
      <img src="/lazysoft-logo.webp" alt="Логотип lazysoft: черепаха отдыхает на пляже с ноутбуком" />
      <span class="brand-name">lazy<em>soft</em></span>
    </a>
    <nav class="nav-links" aria-label="Основная навигация">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav-cta" href="#contact">Написать</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow reveal">
          <span class="dot"></span> Разработчик - Коллекционер идей - Профессионально отдыхаю
        </p>
        <h1 class="hero-title">
          <span class="reveal" style="--d:.05s">Слишком много</span>
          <span class="reveal underline" style="--d:.12s">идей.</span>
          <span class="reveal" style="--d:.19s">Слишком мало</span>
          <span class="reveal wavy" style="--d:.26s">гамаков.</span>
        </h1>
        <p class="hero-sub reveal" style="--d:.36s">
          Я разработчик с блокнотом, полным пет-проектов, и сердцем, полным
          хороших намерений. Некоторые даже вышли в свет. Остальные загорают.
        </p>
        <div class="hero-actions reveal" style="--d:.46s">
          <a class="btn btn-primary" href="#serious">Серьёзные проекты -></a>
          <a class="btn btn-ghost" href="#fun">Весёлые концепты</a>
        </div>

        <div class="ticker reveal" style="--d:.6s" aria-hidden="true">
          <div class="ticker-track">
            {
              ["Серьёзные проекты", "Весёлые концепты", "Амбициозные идеи", "медленные релизы", "Серьёзные проекты", "Весёлые концепты", "Амбициозные идеи", "медленные релизы"].map(
                (item) => <span>{item}</span>,
              )
            }
          </div>
        </div>
      </div>

      <figure class="hero-art reveal" style="--d:.3s">
        <div class="art-ring"></div>
        <img
          src="/lazysoft-logo.webp"
          alt="Мультяшная черепаха в очках сидит на пляже и печатает на ноутбуке рядом с коктейлем и пляжным зонтом"
        />
        <span class="float-chip chip-1">деплой в понедельник</span>
        <span class="float-chip chip-2">v0.0.1 - навсегда</span>
        <span class="float-chip chip-3">// потом</span>
      </figure>

      <div class="waves" aria-hidden="true">
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
          <path d="M0,64 C240,120 480,16 720,48 C960,80 1200,16 1440,56 L1440,120 L0,120 Z"></path>
        </svg>
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="wave-2">
          <path d="M0,80 C320,30 560,110 800,72 C1040,34 1240,100 1440,70 L1440,120 L0,120 Z"></path>
        </svg>
      </div>
    </section>

    <div class="strip" aria-hidden="true">
      <div class="strip-track">
        {
          [
            "Готово к продакшену",
            "Маленькие эксперименты",
            "Отложено осознанно",
            "Ещё думаю",
            "Готово к продакшену",
            "Маленькие эксперименты",
            "Отложено осознанно",
            "Ещё думаю",
          ].map((item) => (
            <>
              <span>{item}</span>
              <span class="star">✺</span>
            </>
          ))
        }
      </div>
    </div>

    <section class="section shipped" id="serious">
      <div class="section-head">
        <p class="kicker reveal-up">GitHub · open source</p>
        <h2 class="reveal-up">Реальные проекты</h2>
        <p class="lede reveal-up">
          Выборка из публичных репозиториев
          {" "}
          <a href="https://github.com/SeeeRGo/" target="_blank" rel="noreferrer">@SeeeRGo</a>.
          Описания основаны на коде и README — без вымышленных пользователей, звёзд и результатов.
        </p>
      </div>

      <div class="project-list">
        {
          seriousProjects.map((project, index) => (
            <a
              class="project reveal-up"
              href={project.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${project.title} на GitHub`}
              style={`--i:${index}`}
            >
              <div class="project-meta">
                <span class="project-year">{project.year}</span>
                <span class="project-stack">{project.stack}</span>
              </div>
              <div class="project-copy">
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>
              <span class="project-go">GitHub ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section ideas" id="fun">
      <div class="section-head">
        <p class="kicker reveal-up">Маленькие эксперименты</p>
        <h2 class="reveal-up">Весёлые концепты</h2>
        <p class="lede reveal-up">
          Реальные демо, прототипы и пет-проекты из GitHub. Степень готовности указана
          прямо на карточке — от рабочего демо до архивного эксперимента.
        </p>
      </div>

      <div class="idea-grid">
        {
          funConcepts.map((concept, index) => (
            <a
              class="idea-card reveal-up"
              href={concept.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${concept.title} на GitHub`}
              style={`--i:${index}`}
            >
              <header>
                <span class="idea-no">{String(index + 1).padStart(2, "0")}</span>
                <span class={`tag ${concept.tagClass}`}>{concept.tag}</span>
              </header>
              <h3>{concept.title}</h3>
              <p>{concept.description}</p>
              <footer>
                <span>{concept.meta}</span>
                <span>{concept.status}</span>
              </footer>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section ambitious" id="ambitious">
      <div class="section-head">
        <p class="kicker reveal-up">Начато и отложено</p>
        <h2 class="reveal-up">Амбициозные идеи</h2>
        <p class="lede reveal-up">
          Более крупные WIP- и хакатонные репозитории. Это не обещания будущих продуктов:
          карточки показывают реализованную основу и текущий статус проекта.
        </p>
      </div>

      <div class="idea-grid">
        {
          ambitiousIdeas.map((idea, index) => (
            <a
              class="idea-card reveal-up"
              href={idea.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${idea.title} на GitHub`}
              style={`--i:${index}`}
            >
              <header>
                <span class="idea-no">{String(index + 1).padStart(2, "0")}</span>
                <span class={`tag ${idea.tagClass}`}>{idea.tag}</span>
              </header>
              <h3>{idea.title}</h3>
              <p>{idea.description}</p>
              <footer>
                <span>{idea.meta}</span>
                <span>{idea.status}</span>
              </footer>
            </a>
          ))
        }

        <a
          class="idea-card idea-add reveal-up"
          href="https://github.com/SeeeRGo?tab=repositories"
          target="_blank"
          rel="noreferrer"
          style={`--i:${ambitiousIdeas.length}`}
        >
          <span class="plus">↗</span>
          <h3>Все репозитории</h3>
          <p>Открыть полный список публичных проектов в профиле SeeeRGo на GitHub.</p>
        </a>
      </div>
    </section>

    <section class="section journey" id="journey">
      <div class="section-head">
        <p class="kicker reveal-up">Опыт + тексты</p>
        <h2 class="reveal-up">Мой путь в IT</h2>
        <p class="lede reveal-up">
          Senior frontend / full-stack developer с 8+ годами опыта в продуктовых и бизнес-системах:
          финтех, образование, внутренние инструменты, ecommerce, ERP, web3 и редкие браузерные расширения.
        </p>
      </div>

      <div class="journey-layout">
        <div class="journey-summary reveal-up" style="--i:0">
          <div class="journey-stats" aria-label="Краткое резюме">
            <span><strong>8+ лет</strong> коммерческого опыта</span>
            <span><strong>Senior / Lead</strong> frontend-роли</span>
            <span><strong>React + TS</strong> основной стек</span>
          </div>
          <div class="timeline">
            {
              timeline.map((item) => (
                <article>
                  <span>{item.period}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="writing-panel reveal-up" style="--i:1">
          <div class="writing-head">
            <p class="kicker">Статьи на Хабре</p>
            <h3>Публичный блокнот разработчика</h3>
            <p>
              Шесть статей на Хабре с 2022 года и 58K+ прочтений: Shape Up, процессы разработки,
              техническая документация, удержание сотрудников, браузерные расширения и вайбкодинг.
            </p>
            <a class="text-link" href="https://habr.com/ru/users/SeeeRgo/articles/" target="_blank" rel="noopener noreferrer">
              Открыть профиль на Хабре ->
            </a>
          </div>
          <div class="writing-list">
            {
              highlightedArticles.map((article) => (
                <a href={article.href} target="_blank" rel="noopener noreferrer">
                  <span>{article.meta}</span>
                  <strong>{article.title}</strong>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section agent-consultation" id="agents" data-agent-voice>
      <div class="section-head agent-section-head">
        <p class="kicker reveal-up">Предварительные переговоры</p>
        <h2 class="reveal-up">Поговорите с агентом<br />до разработки агента</h2>
        <p class="lede reveal-up">
          Короткая демонстрация первой консультации: что уже можно автоматизировать,
          где сегодня находится рынок и какой проверяемый результат должен остаться после пилота.
        </p>
      </div>

      <div class="agent-demo reveal-up">
        <div class="agent-demo-bar">
          <div class="agent-demo-title">
            <span class="agent-live-dot" aria-hidden="true"></span>
            <span>Сессия 001 · AI-agent discovery</span>
          </div>
          <span class="agent-demo-meta">6 сообщений · ~2 минуты</span>
        </div>

        <div class="agent-demo-grid">
          <div class="agent-dialogue" id="agent-dialogue" aria-label="Пример предварительной консультации">
            {
              agentConversation.map((message, index) => (
                <article
                  class={`agent-message agent-message-${message.roleClass}`}
                  data-voice-message
                  data-voice-role={message.role}
                >
                  <header>
                    <span class="agent-avatar" aria-hidden="true">
                      {message.roleClass === "agent" ? "AI" : "ВЫ"}
                    </span>
                    <strong>{message.role}</strong>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                  </header>
                  <p class="agent-message-text">{message.text}</p>
                </article>
              ))
            }
          </div>

          <aside class="agent-voice-panel" aria-label="Голосовая версия консультации">
            <div class="voice-orbit" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <p class="voice-overline">Голосовой формат</p>
            <h3>Прослушать всю консультацию</h3>
            <p>
              Браузер озвучит тот же диалог на русском и подсветит текущую реплику.
              Никакой записи голоса или отправки данных на сервер.
            </p>
            <div class="voice-controls">
              <button class="voice-button voice-button-primary" type="button" data-voice-toggle aria-controls="agent-dialogue">
                <span class="voice-button-icon" aria-hidden="true">▶</span>
                <span data-voice-label>Слушать</span>
              </button>
              <button class="voice-button voice-button-stop" type="button" data-voice-stop disabled>
                <span aria-hidden="true">■</span>
                Стоп
              </button>
            </div>
            <p class="voice-status" data-voice-status aria-live="polite">
              Готово к воспроизведению
            </p>
            <div class="voice-note">
              <span aria-hidden="true">↳</span>
              Голос зависит от доступных системных голосов устройства.
            </div>
          </aside>
        </div>
      </div>

      <div class="agent-market reveal-up">
        <div class="agent-market-intro">
          <p class="kicker">Среднее состояние рынка · 2026</p>
          <h3>Агенты уже в production.<br />Зрелость контроля ещё догоняет.</h3>
          <p>
            Ориентир по опросу LangChain среди 1300+ инженеров, product-менеджеров и руководителей.
            Это срез активной AI-аудитории, а не обещание результата для каждой компании.
          </p>
        </div>
        <div class="agent-market-stats">
          <article>
            <strong>57%</strong>
            <span>респондентов уже используют агентов в production</span>
          </article>
          <article>
            <strong>32%</strong>
            <span>называют качество одним из главных барьеров</span>
          </article>
          <article>
            <strong>89 / 52</strong>
            <span>% внедрили observability / системные evals</span>
          </article>
        </div>
      </div>

      <div class="agent-outcome-grid">
        <article class="agent-outcome-card reveal-up">
          <span class="agent-card-no">01 · Возможности</span>
          <h3>Что агент делает сам</h3>
          <ul>
            <li>понимает текст и голос, уточняет недостающий контекст;</li>
            <li>ищет данные в CRM, документах, почте и базе знаний;</li>
            <li>готовит ответ, задачу или решение и вызывает нужный инструмент;</li>
            <li>останавливается перед рискованным действием и зовёт человека.</li>
          </ul>
        </article>

        <article class="agent-outcome-card agent-outcome-card-accent reveal-up">
          <span class="agent-card-no">02 · Результат пилота</span>
          <h3>Не чатик, а измеримый контур</h3>
          <div class="agent-result-flow" aria-label="Пример результата внедрения">
            <span><small>до</small> поиск вручную<br />7 шагов</span>
            <b aria-hidden="true">→</b>
            <span><small>после</small> готовый черновик<br />2 проверки</span>
          </div>
          <p>
            Цель примера — сократить путь от обращения до проверенного действия.
            Фактический эффект считаем по вашей базовой линии, а не по чужому кейсу.
          </p>
        </article>

        <article class="agent-outcome-card reveal-up">
          <span class="agent-card-no">03 · Путь в production</span>
          <h3>Сначала узкий сценарий</h3>
          <ol>
            <li><strong>3–5 дней</strong> — процессы, данные, риски и baseline;</li>
            <li><strong>2–4 недели</strong> — пилот на реальных примерах;</li>
            <li><strong>дальше</strong> — evals, права, мониторинг и масштабирование.</li>
          </ol>
        </article>
      </div>

      <div class="agent-sources reveal-up">
        <span>Методология и рыночный контекст:</span>
        <a href="https://www.langchain.com/state-of-agent-engineering" target="_blank" rel="noopener noreferrer">
          LangChain · State of Agent Engineering 2026 ↗
        </a>
        <a href="https://www.anthropic.com/engineering/building-effective-agents" target="_blank" rel="noopener noreferrer">
          Anthropic · Building Effective Agents ↗
        </a>
        <a
          href="https://openai.com/business/guides-and-resources/a-practical-guide-to-building-ai-agents/"
          target="_blank"
          rel="noopener noreferrer"
        >
          OpenAI · Practical Guide to Building Agents ↗
        </a>
      </div>
    </section>

    <section class="section words" id="words">
      <div class="section-head">
        <p class="kicker reveal-up">Опубликовано на Хабре</p>
        <h2 class="reveal-up">Тексты, которые всё-таки вышли</h2>
        <p class="lede reveal-up">
          Заметки о процессах, продуктовом мышлении, документации, удержании сотрудников,
          браузерных расширениях и том, как разработка с AI-ассистентами меняет привычки разработчика.
        </p>
      </div>

      <ul class="article-list">
        {
          articles.map((article, index) => (
            <li class="article reveal-up" style={`--i:${index}`}>
              <a href={article.href} target="_blank" rel="noopener noreferrer">
                <span class="article-date">{article.date}</span>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span class="article-read">Читать на Хабре -></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section contact" id="contact">
      <div class="contact-card reveal-up">
        <h2>Давайте соберём что-нибудь из этого.<br />Когда-нибудь.</h2>
        <p>
          Есть идея, достойная попасть в пачку, проект для совместной работы или просто желание
          поспорить о том, считается ли отдых работой? Мой почтовый ящик медленный, но тёплый.
        </p>
        <div class="contact-links">
          <a class="btn btn-primary" href="mailto:hello@lazysoft.dev">hello@lazysoft.dev</a>
          <a class="btn btn-ghost" href="#">GitHub</a>
          <a class="btn btn-ghost" href="#">RSS</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <img src="/lazysoft-logo.webp" alt="Логотип lazysoft с черепахой" />
        <p>lazy<em>soft</em><br /><small>Медленное ПО, сделанное с заботой (и перекусами).</small></p>
      </div>
      <nav class="footer-nav" aria-label="Подвал">
        {navLinks.map((link) => <a href={link.href}>{link.footerLabel}</a>)}
        <a href="#contact">Контакт</a>
      </nav>
    </div>
    <p class="footer-fine">
      © <span id="year"></span> lazysoft - Сделано между снами. Ни одна идея не пострадала, только была отложена.
    </p>
  </footer>
</BaseLayout>
