---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "lazysoft - серьёзные проекты, весёлые концепты и амбициозные идеи";
const description =
  "Портфолио разработчика: серьёзные проекты, готовые к продакшену, весёлые концепты, амбициозные идеи и статьи на Хабре.";

const navLinks = [
  { href: "#serious", label: "Проекты", footerLabel: "Серьёзные проекты" },
  { href: "#fun", label: "Концепты", footerLabel: "Весёлые концепты" },
  { href: "#ambitious", label: "Идеи", footerLabel: "Амбициозные идеи" },
  { href: "#journey", label: "Путь", footerLabel: "Путь в IT" },
  { href: "#words", label: "Статьи", footerLabel: "Статьи" },
];

const seriousProjects = [
  {
    year: "2026",
    stack: "Node.js · SQLite · Docker",
    title: "Script Factory",
    description:
      "Сервис выполнения сценариев с приоритетной очередью, persistent jobs, JSON-интерпретатором шагов, Swagger и визуальным мониторингом.",
    href: "https://github.com/SeeeRGo/script_factory",
  },
  {
    year: "2026",
    stack: "TypeScript · Convex · OpenAI",
    title: "LinkedIn Discourse Intelligence",
    description:
      "Система мониторинга fashion- и retail-дискурса: поиск авторов через Apify, AI-скоринг публикаций и комментариев, интерфейс в Convex и Telegram-дайджест.",
    href: "https://github.com/SeeeRGo/linkedin_intelligence",
  },
  {
    year: "2025",
    stack: "React · TypeScript · Chrome",
    title: "Swagger Converter Extension",
    description:
      "Браузерное расширение: принимает Swagger/OpenAPI-спецификацию и формирует DOCX с описанием эндпоинтов, запросов и ответов.",
    href: "https://github.com/SeeeRGo/swagger-converter-extension",
  },
  {
    year: "2026",
    stack: "Manifest V3 · OAuth 2.0",
    title: "Calendar Conference Integrator",
    description:
      "Расширение для Google Calendar, которое добавляет ссылки Яндекс Телемоста, Jitsi, Zoom или Teams при создании события.",
    href: "https://github.com/SeeeRGo/v0-calendar-conference-variety",
  },
];

const funConcepts = [
  {
    tag: "прототип",
    title: "Photo Liftoff",
    description:
      "Превращает фотографию в задачу генерации короткого видео: drag-and-drop, подсказки для промпта, mock-режим и подключаемый Replicate-совместимый провайдер.",
    meta: "JavaScript · AI video",
    status: "mock + provider",
    tagClass: "tag-soon",
    href: "https://github.com/SeeeRGo/AI-video",
  },
  {
    tag: "демо",
    title: "Voice Agent Demo",
    description:
      "Браузерный голосовой агент: микрофон и WebRTC, потоковый ответ OpenAI Realtime API, live-транскрипт и лента событий для отладки.",
    meta: "WebRTC · Realtime API",
    status: "рабочее демо",
    tagClass: "tag-maybe",
    href: "https://github.com/SeeeRGo/demo-voice-agent",
  },
  {
    tag: "приложение",
    title: "Business Forecast",
    description:
      "Интерфейс финансового прогноза с таблицами доходов, расходов и начальных балансов, вычислениями, авторизацией и автосохранением.",
    meta: "Next.js · Effector · MUI",
    status: "есть live demo",
    tagClass: "tag-someday",
    href: "https://github.com/SeeeRGo/business-forecast",
  },
  {
    tag: "эксперимент",
    title: "Instant Karaoke",
    description:
      "Пайплайн создаёт караоке-видео из аудио: отделяет вокал, распознаёт слова с таймкодами, анимирует текст и сохраняет результат.",
    meta: "Python · Whisper · Manim",
    status: "архив эксперимента",
    tagClass: "tag-soon",
    href: "https://github.com/SeeeRGo/instant-karaoke",
  },
];

const ambitiousIdeas = [
  {
    tag: "WIP",
    title: "GitHub for DOCX",
    description:
      "Платформа для совместной работы с DOCX по модели Git: версии, ветки, pull request, diff и комментарии. README честно фиксирует проект как work in progress.",
    meta: "Next.js · Prisma · tRPC",
    status: "в разработке",
    tagClass: "tag-someday",
    href: "https://github.com/SeeeRGo/github-for-docx",
  },
  {
    tag: "MVP",
    title: "Blockchain Diploma Verification",
    description:
      "Система выдачи и выборочной проверки цифровых дипломов с Convex-бэкендом, деревьями Меркла и закреплением доказательств в Ethereum L2.",
    meta: "Next.js · Convex · Solidity",
    status: "MVP",
    tagClass: "tag-maybe",
    href: "https://github.com/SeeeRGo/mvp-blockchain",
  },
  {
    tag: "хакатон",
    title: "Partial Vote Delegation",
    description:
      "Прототип постоянного голосования: смарт-контракт хранит голоса, а граф делегирования позволяет распределять голос между несколькими представителями.",
    meta: "TypeScript · Solidity",
    status: "прототип",
    tagClass: "tag-someday",
    href: "https://github.com/SeeeRGo/chainlink-hackathon-project",
  },
];

const timeline = [
  {
    period: "2025-2026",
    title: "Senior frontend на боевых платформах",
    description:
      "Работа над платформой Столото, интерфейсами Тольяттинского государственного университета и сложными продуктовыми сценариями на React, Next.js, Nx, React Query, Webpack и GitLab CI.",
  },
  {
    period: "2023-2025",
    title: "Финтех и бэк-офисные системы",
    description:
      "Миграция крупного банковского сервиса на современный фронтенд-стек, интеграция микрофронтенд-компонентов между командами, подготовка релизов, код-ревью и плотная работа с аналитиками.",
  },
  {
    period: "2018-2022",
    title: "Образование, ERP, ecommerce и web3",
    description:
      "Сложные SPA, общий код для web/mobile, динамические формы, таблицы, тесты, Storybook, QR-сканирование, карты и аукционные механики. На образовательной платформе вырос из frontend-разработчика в лида команды.",
  },
];

const highlightedArticles = [
  {
    href: "https://habr.com/ru/articles/1020956/",
    meta: "2026 - 22.7K прочтений",
    title: "Необратимые изменения в мозгу вайбкодера",
  },
  {
    href: "https://habr.com/ru/articles/926742/",
    meta: "2025 - 9.4K прочтений",
    title: "Вы все еще документируете сваггер спецификации вручную?",
  },
  {
    href: "https://habr.com/ru/articles/872120/",
    meta: "2025 - 10.4K прочтений",
    title: "Индекс галерности и удержание сотрудников",
  },
  {
    href: "https://habr.com/ru/articles/692040/",
    meta: "2022 - 12.3K прочтений",
    title: "Введение в Shape Up",
  },
];

const articles = [
  {
    href: "https://habr.com/ru/articles/1020956/",
    date: "Апр 2026 - 3 мин - 22.7K прочтений",
    title: "Необратимые изменения в мозгу вайбкодера",
    description: "Рефлексия о годе вайбкодинга через опыт разработки свежего браузерного расширения.",
  },
  {
    href: "https://habr.com/ru/articles/926742/",
    date: "Июл 2025 - 3 мин - 9.4K прочтений",
    title: "Вы все еще документируете сваггер спецификации вручную?",
    description:
      "Практическая статья о Chrome-расширении, которое превращает Swagger/OpenAPI-спецификации в документацию.",
  },
  {
    href: "https://habr.com/ru/articles/872120/",
    date: "Янв 2025 - 5 мин - 10.4K прочтений",
    title: "Индекс галерности и удержание сотрудников",
    description:
      "Размышление про аутсорс, аутстафф, процессы в компаниях и почему удержание сотрудников - это не просто HR-лозунг.",
  },
  {
    href: "https://habr.com/ru/articles/709876/",
    date: "Мар 2023 - 8 мин - 1.3K прочтений",
    title: "Разработка свободная от ритуалов",
    description: "Кейс о попытке применить Shape Up в реальной задаче и сохранить полезные выводы даже после неудачи.",
  },
  {
    href: "https://habr.com/ru/articles/703086/",
    date: "Дек 2022 - 8 мин - 1.9K прочтений",
    title: "Поиски баланса в составлении функциональных требований",
    description: "Продолжение серии про Shape Up с фокусом на shaping требований до начала реализации.",
  },
  {
    href: "https://habr.com/ru/articles/692040/",
    date: "Окт 2022 - 7 мин - 12.3K прочтений",
    title: "Мейнстримовый Agile пора выбрасывать на свалку истории!?",
    description: "Первая статья про Shape Up: взгляд разработчика на процессы за пределами привычных Agile-ритуалов.",
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="grain" aria-hidden="true"></div>
  <div class="sun" aria-hidden="true"><span class="sun-core"></span></div>

  <header class="nav" id="top">
    <a class="brand" href="#top">
      <img src="/lazysoft-logo.webp" alt="Логотип lazysoft: черепаха отдыхает на пляже с ноутбуком" />
      <span class="brand-name">lazy<em>soft</em></span>
    </a>
    <nav class="nav-links" aria-label="Основная навигация">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav-cta" href="#contact">Написать</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow reveal">
          <span class="dot"></span> Разработчик - Коллекционер идей - Профессионально отдыхаю
        </p>
        <h1 class="hero-title">
          <span class="reveal" style="--d:.05s">Слишком много</span>
          <span class="reveal" style="--d:.12s">идей.</span>
          <span class="reveal" style="--d:.19s">Слишком мало</span>
          <span class="reveal hero-emphasis" style="--d:.26s">гамаков.</span>
        </h1>
        <p class="hero-sub reveal" style="--d:.36s">
          Я разработчик с блокнотом, полным пет-проектов, и сердцем, полным
          хороших намерений. Некоторые даже вышли в свет. Остальные загорают.
        </p>
        <div class="hero-actions reveal" style="--d:.46s">
          <a class="btn btn-primary" href="#serious">Серьёзные проекты -></a>
          <a class="btn btn-ghost" href="#fun">Весёлые концепты</a>
        </div>

        <div class="ticker reveal" style="--d:.6s" aria-hidden="true">
          <div class="ticker-track">
            {
              ["Серьёзные проекты", "Весёлые концепты", "Амбициозные идеи", "медленные релизы", "Серьёзные проекты", "Весёлые концепты", "Амбициозные идеи", "медленные релизы"].map(
                (item) => <span>{item}</span>,
              )
            }
          </div>
        </div>
      </div>

      <figure class="hero-art reveal" style="--d:.3s">
        <div class="art-ring"></div>
        <img
          src="/lazysoft-logo.webp"
          alt="Мультяшная черепаха в очках сидит на пляже и печатает на ноутбуке рядом с коктейлем и пляжным зонтом"
        />
        <span class="float-chip chip-1">деплой в понедельник</span>
        <span class="float-chip chip-2">v0.0.1 - навсегда</span>
        <span class="float-chip chip-3">// потом</span>
      </figure>

      <div class="waves" aria-hidden="true">
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
          <path d="M0,64 C240,120 480,16 720,48 C960,80 1200,16 1440,56 L1440,120 L0,120 Z"></path>
        </svg>
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="wave-2">
          <path d="M0,80 C320,30 560,110 800,72 C1040,34 1240,100 1440,70 L1440,120 L0,120 Z"></path>
        </svg>
      </div>
    </section>

    <div class="strip" aria-hidden="true">
      <div class="strip-track">
        {
          [
            "Готово к продакшену",
            "Маленькие эксперименты",
            "Отложено осознанно",
            "Ещё думаю",
            "Готово к продакшену",
            "Маленькие эксперименты",
            "Отложено осознанно",
            "Ещё думаю",
          ].map((item) => (
            <>
              <span>{item}</span>
              <span class="star">✺</span>
            </>
          ))
        }
      </div>
    </div>

    <section class="section shipped" id="serious">
      <div class="section-head">
        <p class="kicker reveal-up">GitHub · open source</p>
        <h2 class="reveal-up">Реальные проекты</h2>
        <p class="lede reveal-up">
          Выборка из публичных репозиториев
          {" "}
          <a href="https://github.com/SeeeRGo/" target="_blank" rel="noreferrer">@SeeeRGo</a>.
          Описания основаны на коде и README — без вымышленных пользователей, звёзд и результатов.
        </p>
      </div>

      <div class="project-list">
        {
          seriousProjects.map((project, index) => (
            <a
              class="project reveal-up"
              href={project.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${project.title} на GitHub`}
              style={`--i:${index}`}
            >
              <div class="project-meta">
                <span class="project-year">{project.year}</span>
                <span class="project-stack">{project.stack}</span>
              </div>
              <div class="project-copy">
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>
              <span class="project-go">GitHub ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section ideas" id="fun">
      <div class="section-head">
        <p class="kicker reveal-up">Маленькие эксперименты</p>
        <h2 class="reveal-up">Весёлые концепты</h2>
        <p class="lede reveal-up">
          Реальные демо, прототипы и пет-проекты из GitHub. Степень готовности указана
          прямо на карточке — от рабочего демо до архивного эксперимента.
        </p>
      </div>

      <div class="idea-grid">
        {
          funConcepts.map((concept, index) => (
            <a
              class="idea-card reveal-up"
              href={concept.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${concept.title} на GitHub`}
              style={`--i:${index}`}
            >
              <header>
                <span class="idea-no">{String(index + 1).padStart(2, "0")}</span>
                <span class={`tag ${concept.tagClass}`}>{concept.tag}</span>
              </header>
              <h3>{concept.title}</h3>
              <p>{concept.description}</p>
              <footer>
                <span>{concept.meta}</span>
                <span>{concept.status}</span>
              </footer>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section ambitious" id="ambitious">
      <div class="section-head">
        <p class="kicker reveal-up">Начато и отложено</p>
        <h2 class="reveal-up">Амбициозные идеи</h2>
        <p class="lede reveal-up">
          Более крупные WIP- и хакатонные репозитории. Это не обещания будущих продуктов:
          карточки показывают реализованную основу и текущий статус проекта.
        </p>
      </div>

      <div class="idea-grid">
        {
          ambitiousIdeas.map((idea, index) => (
            <a
              class="idea-card reveal-up"
              href={idea.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${idea.title} на GitHub`}
              style={`--i:${index}`}
            >
              <header>
                <span class="idea-no">{String(index + 1).padStart(2, "0")}</span>
                <span class={`tag ${idea.tagClass}`}>{idea.tag}</span>
              </header>
              <h3>{idea.title}</h3>
              <p>{idea.description}</p>
              <footer>
                <span>{idea.meta}</span>
                <span>{idea.status}</span>
              </footer>
            </a>
          ))
        }

        <a
          class="idea-card idea-add reveal-up"
          href="https://github.com/SeeeRGo?tab=repositories"
          target="_blank"
          rel="noreferrer"
          style={`--i:${ambitiousIdeas.length}`}
        >
          <span class="plus">↗</span>
          <h3>Все репозитории</h3>
          <p>Открыть полный список публичных проектов в профиле SeeeRGo на GitHub.</p>
        </a>
      </div>
    </section>

    <section class="section journey" id="journey">
      <div class="section-head">
        <p class="kicker reveal-up">Опыт + тексты</p>
        <h2 class="reveal-up">Мой путь в IT</h2>
        <p class="lede reveal-up">
          Senior frontend / full-stack developer с 8+ годами опыта в продуктовых и бизнес-системах:
          финтех, образование, внутренние инструменты, ecommerce, ERP, web3 и редкие браузерные расширения.
        </p>
      </div>

      <div class="journey-layout">
        <div class="journey-summary reveal-up" style="--i:0">
          <div class="journey-stats" aria-label="Краткое резюме">
            <span><strong>8+ лет</strong> коммерческого опыта</span>
            <span><strong>Senior / Lead</strong> frontend-роли</span>
            <span><strong>React + TS</strong> основной стек</span>
          </div>
          <div class="timeline">
            {
              timeline.map((item) => (
                <article>
                  <span>{item.period}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="writing-panel reveal-up" style="--i:1">
          <div class="writing-head">
            <p class="kicker">Статьи на Хабре</p>
            <h3>Публичный блокнот разработчика</h3>
            <p>
              Шесть статей на Хабре с 2022 года и 58K+ прочтений: Shape Up, процессы разработки,
              техническая документация, удержание сотрудников, браузерные расширения и вайбкодинг.
            </p>
            <a class="text-link" href="https://habr.com/ru/users/SeeeRgo/articles/" target="_blank" rel="noopener noreferrer">
              Открыть профиль на Хабре ->
            </a>
          </div>
          <div class="writing-list">
            {
              highlightedArticles.map((article) => (
                <a href={article.href} target="_blank" rel="noopener noreferrer">
                  <span>{article.meta}</span>
                  <strong>{article.title}</strong>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section words" id="words">
      <div class="section-head">
        <p class="kicker reveal-up">Опубликовано на Хабре</p>
        <h2 class="reveal-up">Тексты, которые всё-таки вышли</h2>
        <p class="lede reveal-up">
          Заметки о процессах, продуктовом мышлении, документации, удержании сотрудников,
          браузерных расширениях и том, как разработка с AI-ассистентами меняет привычки разработчика.
        </p>
      </div>

      <ul class="article-list">
        {
          articles.map((article, index) => (
            <li class="article reveal-up" style={`--i:${index}`}>
              <a href={article.href} target="_blank" rel="noopener noreferrer">
                <span class="article-date">{article.date}</span>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span class="article-read">Читать на Хабре -></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section contact" id="contact">
      <div class="contact-card reveal-up">
        <h2>Давайте соберём что-нибудь из этого.<br />Когда-нибудь.</h2>
        <p>
          Есть идея, достойная попасть в пачку, проект для совместной работы или просто желание
          поспорить о том, считается ли отдых работой? Мой почтовый ящик медленный, но тёплый.
        </p>
        <div class="contact-links">
          <a class="btn btn-primary" href="mailto:hello@lazysoft.dev">hello@lazysoft.dev</a>
          <a class="btn btn-ghost" href="#">GitHub</a>
          <a class="btn btn-ghost" href="#">RSS</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <img src="/lazysoft-logo.webp" alt="Логотип lazysoft с черепахой" />
        <p>lazy<em>soft</em><br /><small>Медленное ПО, сделанное с заботой (и перекусами).</small></p>
      </div>
