---
import SiteLayout from "../layouts/SiteLayout.astro";
import { apps, services } from "../data/catalog";

const title = "Разработка веб-приложений и автоматизация бизнеса — Lazysoft";
const description =
  "Разработка веб-приложений, внутренних систем, браузерных расширений и MVP. Lazysoft автоматизирует повторяющиеся бизнес-процессы.";

const funConcepts = [
  {
    tag: "прототип",
    title: "Photo Liftoff",
    description:
      "Превращает фотографию в задачу генерации короткого видео: drag-and-drop, подсказки для промпта, mock-режим и подключаемый Replicate-совместимый провайдер.",
    meta: "JavaScript · AI video",
    status: "mock + provider",
    tagClass: "tag-soon",
    href: "https://github.com/SeeeRGo/AI-video",
  },
  {
    tag: "приложение",
    title: "Business Forecast",
    description:
      "Интерфейс финансового прогноза с таблицами доходов, расходов и начальных балансов, вычислениями, авторизацией и автосохранением.",
    meta: "Next.js · Effector · MUI",
    status: "есть live demo",
    tagClass: "tag-someday",
    href: "https://github.com/SeeeRGo/business-forecast",
  },
  {
    tag: "эксперимент",
    title: "Instant Karaoke",
    description:
      "Пайплайн создаёт караоке-видео из аудио: отделяет вокал, распознаёт слова с таймкодами, анимирует текст и сохраняет результат.",
    meta: "Python · Whisper · Manim",
    status: "архив эксперимента",
    tagClass: "tag-soon",
    href: "https://github.com/SeeeRGo/instant-karaoke",
  },
];

const ambitiousIdeas = [
  {
    tag: "WIP",
    title: "GitHub for DOCX",
    description:
      "Платформа для совместной работы с DOCX по модели Git: версии, ветки, pull request, diff и комментарии. README честно фиксирует проект как work in progress.",
    meta: "Next.js · Prisma · tRPC",
    status: "в разработке",
    tagClass: "tag-someday",
    href: "https://github.com/SeeeRGo/github-for-docx",
  },
  {
    tag: "MVP",
    title: "Blockchain Diploma Verification",
    description:
      "Система выдачи и выборочной проверки цифровых дипломов с Convex-бэкендом, деревьями Меркла и закреплением доказательств в Ethereum L2.",
    meta: "Next.js · Convex · Solidity",
    status: "MVP",
    tagClass: "tag-maybe",
    href: "https://github.com/SeeeRGo/mvp-blockchain",
  },
  {
    tag: "хакатон",
    title: "Partial Vote Delegation",
    description:
      "Прототип постоянного голосования: смарт-контракт хранит голоса, а граф делегирования позволяет распределять голос между несколькими представителями.",
    meta: "TypeScript · Solidity",
    status: "прототип",
    tagClass: "tag-someday",
    href: "https://github.com/SeeeRGo/chainlink-hackathon-project",
  },
];

const lazyPrinciples = [
  {
    no: "01",
    title: "Замечаем повторение",
    description:
      "Если действие приходится делать снова и снова, это уже кандидат на приложение, а не часть вашей судьбы.",
  },
  {
    no: "02",
    title: "Отдаём рутину софту",
    description:
      "Поиск, перенос данных, подготовку черновика и технические шаги выполняет система. Человеку остаётся решение.",
  },
  {
    no: "03",
    title: "Оставляем контроль",
    description:
      "Полезная лень не равна слепой автоматизации: результат можно проверить, поправить и остановить.",
  },
];

const timeline = [
  {
    period: "2025-2026",
    title: "Senior frontend на боевых платформах",
    description:
      "Работа над платформой Столото, интерфейсами Тольяттинского государственного университета и сложными продуктовыми сценариями на React, Next.js, Nx, React Query, Webpack и GitLab CI.",
  },
  {
    period: "2023-2025",
    title: "Финтех и бэк-офисные системы",
    description:
      "Миграция крупного банковского сервиса на современный фронтенд-стек, интеграция микрофронтенд-компонентов между командами, подготовка релизов, код-ревью и плотная работа с аналитиками.",
  },
  {
    period: "2018-2022",
    title: "Образование, ERP, ecommerce и web3",
    description:
      "Сложные SPA, общий код для web/mobile, динамические формы, таблицы, тесты, Storybook, QR-сканирование, карты и аукционные механики. На образовательной платформе вырос из frontend-разработчика в лида команды.",
  },
];

const highlightedArticles = [
  {
    href: "https://habr.com/ru/articles/1020956/",
    meta: "2026 - 22.7K прочтений",
    title: "Необратимые изменения в мозгу вайбкодера",
  },
  {
    href: "https://habr.com/ru/articles/926742/",
    meta: "2025 - 9.4K прочтений",
    title: "Вы все еще документируете сваггер спецификации вручную?",
  },
  {
    href: "https://habr.com/ru/articles/872120/",
    meta: "2025 - 10.4K прочтений",
    title: "Индекс галерности и удержание сотрудников",
  },
  {
    href: "https://habr.com/ru/articles/692040/",
    meta: "2022 - 12.3K прочтений",
    title: "Введение в Shape Up",
  },
];

const articles = [
  {
    href: "https://habr.com/ru/articles/1020956/",
    date: "Апр 2026 - 3 мин - 22.7K прочтений",
    title: "Необратимые изменения в мозгу вайбкодера",
    description: "Рефлексия о годе вайбкодинга через опыт разработки свежего браузерного расширения.",
  },
  {
    href: "https://habr.com/ru/articles/926742/",
    date: "Июл 2025 - 3 мин - 9.4K прочтений",
    title: "Вы все еще документируете сваггер спецификации вручную?",
    description:
      "Практическая статья о Chrome-расширении, которое превращает Swagger/OpenAPI-спецификации в документацию.",
  },
  {
    href: "https://habr.com/ru/articles/872120/",
    date: "Янв 2025 - 5 мин - 10.4K прочтений",
    title: "Индекс галерности и удержание сотрудников",
    description:
      "Размышление про аутсорс, аутстафф, процессы в компаниях и почему удержание сотрудников - это не просто HR-лозунг.",
  },
  {
    href: "https://habr.com/ru/articles/709876/",
    date: "Мар 2023 - 8 мин - 1.3K прочтений",
    title: "Разработка свободная от ритуалов",
    description: "Кейс о попытке применить Shape Up в реальной задаче и сохранить полезные выводы даже после неудачи.",
  },
  {
    href: "https://habr.com/ru/articles/703086/",
    date: "Дек 2022 - 8 мин - 1.9K прочтений",
    title: "Поиски баланса в составлении функциональных требований",
    description: "Продолжение серии про Shape Up с фокусом на shaping требований до начала реализации.",
  },
  {
    href: "https://habr.com/ru/articles/692040/",
    date: "Окт 2022 - 7 мин - 12.3K прочтений",
    title: "Мейнстримовый Agile пора выбрасывать на свалку истории!?",
    description: "Первая статья про Shape Up: взгляд разработчика на процессы за пределами привычных Agile-ритуалов.",
  },
];
---

<SiteLayout title={title} description={description} canonicalPath="/">
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow reveal">
          <span class="dot"></span> Полезная лень · меньше рутины · больше своего времени
        </p>
        <h1 class="hero-title">
          <span class="reveal" style="--d:.05s">Приложения</span>
          <span class="reveal" style="--d:.12s">работают.</span>
          <span class="reveal" style="--d:.19s">Вы — чуточку</span>
          <span class="reveal hero-emphasis" style="--d:.26s">ленивее.</span>
        </h1>
        <p class="hero-sub reveal" style="--d:.36s">
          Lazysoft забирает повторяющиеся шаги, поиск и перекладывание данных,
          чтобы вам оставались решения, идеи и время на что-то поважнее.
        </p>
        <div class="hero-actions reveal" style="--d:.46s">
          <a class="btn btn-primary" href="/services/">Заказать разработку →</a>
          <a class="btn btn-ghost" href="/apps/">Посмотреть приложения</a>
        </div>
      </div>

      <figure class="hero-art reveal" style="--d:.3s">
        <div class="art-ring"></div>
        <img
          src="/lazysoft-logo.webp"
          alt="Черепаха Lazysoft отдыхает на пляже, пока приложения работают"
        />
        <span class="float-chip chip-1">делает само</span>
        <span class="float-chip chip-2">контроль у вас</span>
        <span class="float-chip chip-3">можно выдохнуть</span>
      </figure>

      <div class="waves" aria-hidden="true">
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
          <path d="M0,64 C240,120 480,16 720,48 C960,80 1200,16 1440,56 L1440,120 L0,120 Z"></path>
        </svg>
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="wave-2">
          <path d="M0,80 C320,30 560,110 800,72 C1040,34 1240,100 1440,70 L1440,120 L0,120 Z"></path>
        </svg>
      </div>
    </section>

    <div class="strip" aria-hidden="true">
      <div class="strip-track">
        {
          [
            "Рутину — приложению",
            "Время — человеку",
            "Меньше переключений",
            "Больше спокойствия",
            "Рутину — приложению",
            "Время — человеку",
            "Меньше переключений",
            "Больше спокойствия",
          ].map((item) => (
            <>
              <span>{item}</span>
              <span class="star">✺</span>
            </>
          ))
        }
      </div>
    </div>

    <section class="section philosophy" id="philosophy">
      <div class="philosophy-shell reveal-up">
        <div class="philosophy-copy">
          <p class="kicker">Что значит Lazysoft</p>
          <h2>Лень — хороший повод<br />спроектировать систему.</h2>
          <p>
            Мы не автоматизируем человека. Мы убираем из его дня механические действия,
            на которые жалко внимания.
          </p>
          <strong>Софт берёт повторение. Вы оставляете себе выбор.</strong>
        </div>

        <div class="principle-grid">
          {
            lazyPrinciples.map((principle) => (
              <article>
                <span>{principle.no}</span>
                <h3>{principle.title}</h3>
                <p>{principle.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section home-services" id="services">
      <div class="section-head">
        <p class="kicker reveal-up">Заказная разработка</p>
        <h2 class="reveal-up">Какой процесс<br />можно упростить</h2>
        <p class="lede reveal-up">
          От узкого расширения до внутренней системы. Каждая услуга получила отдельную страницу
          с подходящими сценариями, составом первого релиза и примерами проектов.
        </p>
      </div>
      <div class="home-service-grid">
        {services.map((service, index) => (
          <a class="home-service-card reveal-up" href={`/services/${service.slug}/`} style={`--i:${index}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <strong>Подробнее →</strong>
          </a>
        ))}
      </div>
      <a class="section-more reveal-up" href="/services/">Все услуги и процесс работы →</a>
    </section>

    <section class="section shipped" id="apps">
      <div class="section-head">
        <p class="kicker reveal-up">Уже забирают рутину</p>
        <h2 class="reveal-up">Приложения Lazysoft</h2>
        <p class="lede reveal-up">
          Реальные публичные репозитории
          {" "}
          <a href="https://github.com/SeeeRGo/" target="_blank" rel="noreferrer">@SeeeRGo</a>.
          Каждое приложение начинается с вопроса: какой повторяющийся шаг можно больше не делать руками?
        </p>
      </div>

      <div class="project-list">
        {
          apps.map((project, index) => (
            <a
              class="project reveal-up"
              href={`/apps/${project.slug}/`}
              aria-label={`Подробнее о приложении ${project.title}`}
              style={`--i:${index}`}
            >
              <div class="project-meta">
                <span class="project-year">{project.year}</span>
                <span class="project-stack">{project.stack.join(" · ")}</span>
              </div>
              <div class="project-copy">
                <span class="project-benefit">{project.benefit}</span>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>
              <span class="project-go">Подробнее →</span>
            </a>
          ))
        }
      </div>
      <a class="section-more reveal-up" href="/apps/">Открыть каталог приложений →</a>
    </section>

    <section class="section ideas" id="lab">
      <div class="section-head">
        <p class="kicker reveal-up">Лаборатория полезной лени</p>
        <h2 class="reveal-up">Что ещё можно<br />перестать делать вручную</h2>
        <p class="lede reveal-up">
          Здесь проверяем идеи: от генерации видео до финансовых расчётов
          и обработки аудио. Статус каждого прототипа указан честно.
        </p>
      </div>

      <div class="idea-grid">
        {
          funConcepts.map((concept, index) => (
            <a
              class="idea-card reveal-up"
              href={concept.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${concept.title} на GitHub`}
              style={`--i:${index}`}
            >
              <header>
                <span class="idea-no">{String(index + 1).padStart(2, "0")}</span>
                <span class={`tag ${concept.tagClass}`}>{concept.tag}</span>
              </header>
              <h3>{concept.title}</h3>
              <p>{concept.description}</p>
              <footer>
                <span>{concept.meta}</span>
                <span>{concept.status}</span>
              </footer>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section ambitious" id="next">
      <div class="section-head">
        <p class="kicker reveal-up">Следующие кандидаты</p>
        <h2 class="reveal-up">Большая рутина,<br />большие системы</h2>
        <p class="lede reveal-up">
          Проекты, где автоматизация требует не одной кнопки, а целого процесса.
          Это WIP- и хакатонные репозитории с реализованной основой и открытым статусом.
        </p>
      </div>

      <div class="idea-grid">
        {
          ambitiousIdeas.map((idea, index) => (
            <a
              class="idea-card reveal-up"
              href={idea.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${idea.title} на GitHub`}
              style={`--i:${index}`}
            >
              <header>
                <span class="idea-no">{String(index + 1).padStart(2, "0")}</span>
                <span class={`tag ${idea.tagClass}`}>{idea.tag}</span>
              </header>
              <h3>{idea.title}</h3>
              <p>{idea.description}</p>
              <footer>
                <span>{idea.meta}</span>
                <span>{idea.status}</span>
              </footer>
            </a>
          ))
        }

        <a
          class="idea-card idea-add reveal-up"
          href="https://github.com/SeeeRGo?tab=repositories"
          target="_blank"
          rel="noreferrer"
          style={`--i:${ambitiousIdeas.length}`}
        >
          <span class="plus">↗</span>
          <h3>Все репозитории</h3>
          <p>Открыть полный список публичных проектов в профиле SeeeRGo на GitHub.</p>
        </a>
      </div>
    </section>

    <section class="section journey" id="about">
      <div class="section-head">
        <p class="kicker reveal-up">Инженерия за спокойствием</p>
        <h2 class="reveal-up">Кто делает Lazysoft</h2>
        <p class="lede reveal-up">
          За простым действием в интерфейсе — 8+ лет опыта в продуктовых и бизнес-системах:
          финтехе, образовании, внутренних инструментах, ecommerce, ERP и web3.
        </p>
      </div>

      <div class="journey-layout">
        <div class="journey-summary reveal-up" style="--i:0">
          <div class="journey-stats" aria-label="Краткое резюме">
            <span><strong>8+ лет</strong> коммерческого опыта</span>
            <span><strong>Senior / Lead</strong> frontend-роли</span>
            <span><strong>React + TS</strong> основной стек</span>
          </div>
          <div class="timeline">
            {
              timeline.map((item) => (
                <article>
                  <span>{item.period}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="writing-panel reveal-up" style="--i:1">
          <div class="writing-head">
            <p class="kicker">Как мы думаем вслух</p>
            <h3>Инженерный блокнот Lazysoft</h3>
            <p>
              Шесть статей на Хабре с 2022 года и 58K+ прочтений: Shape Up, процессы разработки,
              техническая документация, удержание сотрудников, браузерные расширения и вайбкодинг.
            </p>
            <a class="text-link" href="https://habr.com/ru/users/SeeeRgo/articles/" target="_blank" rel="noopener noreferrer">
              Открыть профиль на Хабре ->
            </a>
          </div>
          <div class="writing-list">
            {
              highlightedArticles.map((article) => (
                <a href={article.href} target="_blank" rel="noopener noreferrer">
                  <span>{article.meta}</span>
                  <strong>{article.title}</strong>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section words" id="words">
      <div class="section-head">
        <p class="kicker reveal-up">Заметки о полезной лени</p>
        <h2 class="reveal-up">Как делать меньше лишнего</h2>
        <p class="lede reveal-up">
          О процессах без ритуалов, документации без ручного копирования,
          продуктах без лишних шагов и разработке с AI-ассистентами.
        </p>
      </div>

      <ul class="article-list">
        {
          articles.map((article, index) => (
            <li class="article reveal-up" style={`--i:${index}`}>
              <a href={article.href} target="_blank" rel="noopener noreferrer">
                <span class="article-date">{article.date}</span>
                <h3>{article.title}</h3>
                <p>{article.description}</p>
                <span class="article-read">Читать на Хабре -></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section contact" id="contact">
      <div class="contact-card reveal-up">
        <h2>Что вы делаете руками<br />слишком часто?</h2>
        <p>
          Расскажите о повторяющемся процессе. Посмотрим, может ли приложение
          забрать технические шаги и вернуть вам немного времени.
        </p>
        <div class="contact-links">
          <a class="btn btn-primary" href="/contact/">Обсудить задачу</a>
          <a class="btn btn-ghost" href="https://github.com/SeeeRGo/" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="btn btn-ghost" href="https://habr.com/ru/users/SeeeRgo/articles/" target="_blank" rel="noopener noreferrer">Хабр ↗</a>
        </div>
      </div>
    </section>
</SiteLayout>
