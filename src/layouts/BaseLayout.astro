---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/lazysoft-logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,400..700&family=Space+Mono:wght@400;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      const yearEl = document.getElementById("year");
      if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const revealItems = document.querySelectorAll(".reveal-up");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
        );
        revealItems.forEach((el) => io.observe(el));
      }

      const sun = document.querySelector<HTMLElement>(".sun");
      const art = document.querySelector<HTMLElement>(".hero-art img");
      if (!reduceMotion) {
        let ticking = false;
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(() => {
              const y = window.scrollY;
              if (sun) sun.style.transform = `translateY(${y * 0.18}px)`;
              if (art && y < 900) art.style.transform = `translateY(${y * -0.04}px)`;
              ticking = false;
            });
          },
          { passive: true },
        );
      }

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", (event) => {
          const id = link.getAttribute("href");
          if (!id || id.length < 2) return;
          const target = document.querySelector(id);
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
          history.replaceState(null, "", id);
        });
      });

      const voiceDemo = document.querySelector<HTMLElement>("[data-agent-voice]");
      if (voiceDemo) {
        const toggleButton = voiceDemo.querySelector<HTMLButtonElement>("[data-voice-toggle]");
        const stopButton = voiceDemo.querySelector<HTMLButtonElement>("[data-voice-stop]");
        const label = voiceDemo.querySelector<HTMLElement>("[data-voice-label]");
        const icon = toggleButton?.querySelector<HTMLElement>(".voice-button-icon");
        const status = voiceDemo.querySelector<HTMLElement>("[data-voice-status]");
        const messages = Array.from(voiceDemo.querySelectorAll<HTMLElement>("[data-voice-message]"));

        const setStatus = (text: string) => {
          if (status) status.textContent = text;
        };
        const clearActiveMessage = () => {
          messages.forEach((message) => message.classList.remove("is-speaking"));
        };

        if (
          !toggleButton ||
          !stopButton ||
          !label ||
          !icon ||
          !("speechSynthesis" in window) ||
          !("SpeechSynthesisUtterance" in window)
        ) {
          if (toggleButton) toggleButton.disabled = true;
          if (stopButton) stopButton.disabled = true;
          setStatus("Синтез речи не поддерживается этим браузером");
        } else {
          const synth = window.speechSynthesis;
          let isPlaying = false;
          let isPaused = false;
          let generation = 0;

          const updateControls = (mode: "idle" | "playing" | "paused") => {
            if (mode === "idle") {
              label.textContent = "Слушать";
              icon.textContent = "▶";
              toggleButton.setAttribute("aria-pressed", "false");
              stopButton.disabled = true;
            }
            if (mode === "playing") {
              label.textContent = "Пауза";
              icon.textContent = "Ⅱ";
              toggleButton.setAttribute("aria-pressed", "true");
              stopButton.disabled = false;
            }
            if (mode === "paused") {
              label.textContent = "Продолжить";
              icon.textContent = "▶";
              toggleButton.setAttribute("aria-pressed", "false");
              stopButton.disabled = false;
            }
          };

          const finish = (message = "Готово к воспроизведению") => {
            isPlaying = false;
            isPaused = false;
            clearActiveMessage();
            updateControls("idle");
            setStatus(message);
          };

          const startPlayback = () => {
            generation += 1;
            const currentGeneration = generation;
            synth.cancel();
            clearActiveMessage();

            const russianVoice = synth
              .getVoices()
              .find((voice) => voice.lang.toLowerCase().startsWith("ru"));

            isPlaying = true;
            isPaused = false;
            updateControls("playing");
            setStatus("Начинаю консультацию…");

            messages.forEach((message, index) => {
              const role = message.dataset.voiceRole ?? "";
              const text = message.querySelector<HTMLElement>(".agent-message-text")?.textContent?.trim() ?? "";
              const utterance = new SpeechSynthesisUtterance(`${role}. ${text}`);
              utterance.lang = "ru-RU";
              utterance.rate = role === "Вы" ? 1 : .94;
              utterance.pitch = role === "Вы" ? .94 : 1.04;
              if (russianVoice) utterance.voice = russianVoice;

              utterance.onstart = () => {
                if (generation !== currentGeneration) return;
                clearActiveMessage();
                message.classList.add("is-speaking");
                setStatus(`Реплика ${index + 1} из ${messages.length} · ${role}`);
              };
              utterance.onend = () => {
                if (generation !== currentGeneration) return;
                if (index === messages.length - 1) finish("Консультация завершена");
              };
              utterance.onerror = (event) => {
                if (
                  generation !== currentGeneration ||
                  event.error === "canceled" ||
                  event.error === "interrupted"
                ) {
                  return;
                }
                finish("Не удалось воспроизвести голос. Текстовая версия доступна слева.");
              };

              synth.speak(utterance);
            });
          };

          toggleButton.addEventListener("click", () => {
            if (!isPlaying) {
              startPlayback();
              return;
            }
            if (isPaused) {
              synth.resume();
              isPaused = false;
              updateControls("playing");
              setStatus("Воспроизведение продолжено");
            } else {
              synth.pause();
              isPaused = true;
              updateControls("paused");
              setStatus("Пауза");
            }
          });

          stopButton.addEventListener("click", () => {
            generation += 1;
            synth.cancel();
            finish("Воспроизведение остановлено");
          });

          window.addEventListener("pagehide", () => {
            generation += 1;
            synth.cancel();
          });
        }
      }
    </script>
  </body>
</html>
