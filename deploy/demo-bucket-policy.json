{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicDemoRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::lazysoft-request-demos-20260907/*",
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    },
    {
      "Sid": "LocalDemoUpload",
      "Effect": "Allow",
      "Principal": { "CanonicalUser": "ajecsp78qsi44s7me9tv" },
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::lazysoft-request-demos-20260907/*"
    },
    {
      "Sid": "LocalDemoList",
      "Effect": "Allow",
      "Principal": { "CanonicalUser": "ajecsp78qsi44s7me9tv" },
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::lazysoft-request-demos-20260907"
    }
  ]
}
